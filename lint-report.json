nt":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\ninterface CircularProgressProps {\n  progress: number; // e.g., 40 means 40%\n  imageUrl: string;\n}\n\nconst CircularProgressBar: React.FC<CircularProgressProps> = ({ progress, imageUrl }) => {\n  const size = 120; // overall size of SVG\n  const strokeWidth = 8;\n  const radius = (size - strokeWidth) / 2;\n  const circumference = 2 * Math.PI * radius;\n\n  // control how much of the circle is filled\n  const strokeDashoffset = circumference - (progress / 100) * circumference;\n\n  return (\n    <div className=\"relative flex items-center justify-center w-[120px] h-[120px]\">\n      <svg\n        className=\"rotate-[-90deg]\" // make progress start at top\n        width={size}\n        height={size}\n      >\n        {/* Background circle (gray) */}\n        <circle\n          stroke=\"#E5E7EB\" // gray-200\n          fill=\"transparent\"\n          strokeWidth={strokeWidth}\n          r={radius}\n          cx={size / 2}\n          cy={size / 2}\n        />\n\n        {/* Progress circle (purple) */}\n        <circle\n          stroke=\"#7C3AED\" // purple-600\n          fill=\"transparent\"\n          strokeWidth={strokeWidth}\n          strokeDasharray={circumference}\n          strokeDashoffset={strokeDashoffset}\n          strokeLinecap=\"round\"\n          r={radius}\n          cx={size / 2}\n          cy={size / 2}\n          style={{\n            transition: \"stroke-dashoffset 0.6s ease\",\n          }}\n        />\n      </svg>\n\n      {/* Profile image in center */}\n      <div className=\"absolute flex items-center justify-center\">\n        <img\n          src={imageUrl}\n          alt=\"Profile\"\n          className=\"w-20 h-20 rounded-full border-4 border-white shadow-lg object-cover\"\n        />\n      </div>\n\n      {/* Progress text at bottom (optional) */}\n      <div className=\"absolute bottom-[-18px] text-sm text-gray-600 font-medium\">\n        {progress}%\n      </div>\n    </div>\n  );\n};\n\nexport default CircularProgressBar;\n","usedDeprecatedRules":[]},{"filePath":"/Users/tosin/Nadiron/Estelle/estelle-frontend/src/components/CourseCard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/tosin/Nadiron/Estelle/estelle-frontend/src/components/Cta.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Button' is defined but never used.","line":2,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":2,"endColumn":16}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react'\nimport { Button } from './ui/button'\n\nconst Cta = () => {\n  return (\n    <section className='py-18 lg:py-20'>\n      <div className='max-w-7xl mx-auto px-4 md:px-6'>\n        <div className='bg-[#7852A9] px-10 py-12 rounded-3xl flex flex-col md:flex-row justify-start items-center gap-15 lg:h-[350px]'>\n            <div className='space-y-5'>\n            <h2 className='text-3xl md:text-5xl lg:text-6xl font-bold max-w-2xl tracking-wide text-white'>Ready to build your Personal Brand?</h2>\n            <p className='text-xl text-gray-100 max-w-xl font-light tracking-wide'>Let your personal brand become a legacy with <span className='font-bold text-white'>Estelle</span></p>\n            </div>\n        \n         <a href='https://whatsapp.com/channel/0029VbBA6IzHVvTfvZMufU3M' className=' hover:opacity-90 flex items-center justify-center bg-white text-[#7852A9] hover:bg-[#eeedef] py-4 rounded-2xl font-semibold w-full md:w-[200px]'>Join our community</a>\n\n        </div>\n\n      </div>\n    </section>\n  )\n}\n\nexport default Cta\n","usedDeprecatedRules":[]},{"filePath":"/Users/tosin/Nadiron/Estelle/estelle-frontend/src/compone